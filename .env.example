# Strict comma-separated parser names. Empty, unknown, and duplicate names are rejected.
# Currently supported: pumpfun, pumpswap
PARSERS=pumpfun,pumpswap

# Solana mainnet-beta JSON-RPC endpoint.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana mainnet-beta WebSocket endpoint.
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# PostgreSQL connection used to save token pair prices.
DB_PORT=5432
DB_USERNAME=
DB_NAME=
DB_PASSWORD=
DB_HOST=
DB_DISABLE_SSL=false
